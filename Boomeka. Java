import java.util.*;

class Student {
    String regNo;
    String name;
    String department;
    String hall;
    int seatNo;

    Student(String regNo, String name, String department) {
        this.regNo = regNo;
        this.name = name;
        this.department = department;
    }
}

public class Main {
    static Scanner sc = new Scanner(System.in);
    static ArrayList<Student> students = new ArrayList<>();
    static int hallCapacity = 5;

    static void addStudent() {
        System.out.print("Enter Register Number: ");
        String regNo = sc.nextLine();

        for (Student s : students) {
            if (s.regNo.equalsIgnoreCase(regNo)) {
                System.out.println("Register Number Already Exists!");
                return;
            }
        }

        System.out.print("Enter Student Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Department: ");
        String department = sc.nextLine();

        students.add(new Student(regNo, name, department));
        System.out.println("Student Added Successfully!");
    }

    static void generateSeating() {
        if (students.isEmpty()) {
            System.out.println("No Student Records Found!");
            return;
        }

        students.sort(
            Comparator.comparing(s -> s.department)
        );

        int hallNo = 1;
        int seat = 1;

        for (Student s : students) {
            if (seat > hallCapacity) {
                hallNo++;
                seat = 1;
            }

            s.hall = "Hall-" + hallNo;
            s.seatNo = seat++;
        }

        System.out.println("Seating Arrangement Generated Successfully!");
    }

    static void displayStudents() {
        if (students.isEmpty()) {
            System.out.println("No Student Records Found!");
            return;
        }

        System.out.println("\nEXAM SEATING ARRANGEMENT");
        System.out.println("---------------------------------------------------------------");
        System.out.printf("%-15s %-20s %-12s %-10s %-8s%n",
                "Reg No", "Name", "Department", "Hall", "Seat No");
        System.out.println("---------------------------------------------------------------");

        for (Student s : students) {
            System.out.printf("%-15s %-20s %-12s %-10s %-8s%n",
                    s.regNo, s.name, s.department,
                    s.hall == null ? "Not Allocated" : s.hall,
                    s.seatNo == 0 ? "-" : s.seatNo);
        }
    }

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n====================================");
            System.out.println(" EXAM SEATING ARRANGEMENT GENERATOR");
            System.out.println("====================================");
            System.out.println("1. Add Student");
            System.out.println("2. Generate Seating Arrangement");
            System.out.println("3. Display Seating Plan");
            System.out.println("4. Exit");
            System.out.print("Enter Your Choice: ");

            try {
                choice = Integer.parseInt(sc.nextLine());

                switch (choice) {
                    case 1:
                        addStudent();
                        break;

                    case 2:
                        generateSeating();
                        break;

                    case 3:
                        displayStudents();
                        break;

                    case 4:
                        System.out.println("Thank You!");
                        break;

                    default:
                        System.out.println("Invalid Choice!");
                }
            } catch (NumberFormatException e) {
                System.out.println("Please Enter a Valid Number!");
                choice = 0;
            }

        } while (choice != 4);

        sc.close();
    }
}
